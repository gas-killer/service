torId\",\"type\":\"address\"}],\"name\":\"batchCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"operatorId\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"batchIndex\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"startSlot\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"count\",\"type\":\"uint64\"},{\"internalType\":\"bytes32\",\"name\":\"root\",\"type\":\"bytes32\"}],\"name\":\"batchMessage\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"batches\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"root\",\"type\":\"bytes32\"},{\"internalType\":\"uint64\",\"name\":\"startSlot\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"count\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"operatorId\",\"type\":\"address\"}],\"name\":\"coverage\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"x\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"y\",\"type\":\"uint256\"}],\"name\":\"pointAddress\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"x\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"y\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"root\",\"type\":\"bytes32\"},{\"internalType\":\"uint64\",\"name\":\"count\",\"type\":\"uint64\"},{\"internalType\":\"uint256\",\"name\":\"sigS\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"sigR\",\"type\":\"address\"}],\"name\":\"registerBatch\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"stakeRegistry\",\"outputs\":[{\"internalType\":\"contract ISchnorrStakeRegistry\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Design invariants:      * **Append-only, contiguous coverage**: batch `k` covers        `[end(k-1), end(k-1) + count)` with batch 0 starting at slot 0. Registered        coverage is immutable, so reads at any block are stable and no        `effectiveBlock`-style watermark is needed (unlike the stake registry).      * **Cryptographic authentication, not `msg.sender`**: a registration carries a        single-key Schnorr signature by the operator key over [`batchMessage`], which        binds `(chainid, this registry, operator, batchIndex, startSlot, count, root)` \\u2014        anyone may relay the transaction; replay across deployments/chains or positions        is impossible.      * Only keys registered in the `SchnorrStakeRegistry` (which enforces a proof of        possession) may commit batches.\",\"kind\":\"dev\",\"methods\":{\"batchAt(address,uint64)\":{\"returns\":{\"batchIndex\":\" the batch's position in the operator's list.\",\"offset\":\"     `slot`'s leaf index within the batch.\",\"root\":\"       the batch's Merkle root.\"}},\"registerBatch(uint256,uint256,bytes32,uint64,uint256,address)\":{\"params\":{\"count\":\"slots covered; the batch is assigned `[coverage, coverage + count)`.\",\"root\":\"Merkle root over the batch's `(operator, slot, R1, R2)` leaves.\",\"sigR\":\"registration signature nonce address `address(R)`.\",\"sigS\":\"registration signature scalar `s`.\",\"x\":\"operator pubkey x-coordinate (must be registered in the stake registry).\",\"y\":\"operator pubkey y-coordinate.\"}}},\"title\":\"SchnorrNonceRegistry\",\"version\":1},\"userdoc\":{\"events\":{\"NonceBatchRegistered(address,uint64,uint64,uint64,bytes32)\":{\"notice\":\"Emitted for every registered batch; nodes watch this to pull the batch p2p.\"}},\"kind\":\"user\",\"methods\":{\"MAX_BATCH_SLOTS()\":{\"notice\":\"Hard cap on slots per batch (mirrors the Rust `MAX_BATCH_SLOTS`); bounds the p2p gossip size a single registration can demand.\"},\"batchAt(address,uint64)\":{\"notice\":\"The batch covering `slot` for `operatorId`.\"},\"batchCount(address)\":{\"notice\":\"Number of batches an operator has registered.\"},\"batchMessage(address,uint64,uint64,uint64,bytes32)\":{\"notice\":\"The message a batch registration must sign. `uint64` fields are 8-byte         big-endian under `abi.encodePacked` \\u2014 the Rust `batch_message` mirrors         this byte-for-byte.\"},\"batches(address,uint256)\":{\"notice\":\"operator identity (`pointAddress` of its Schnorr key) \\u2192 append-only batch list.\"},\"coverage(address)\":{\"notice\":\"One past the operator's last committed slot (0 if no batches).\"},\"pointAddress(uint256,uint256)\":{\"notice\":\"The identity address of a public-key point \\u2014 same formula as         `SchnorrStakeRegistry.pointAddress`.\"},\"registerBatch(uint256,uint256,bytes32,uint64,uint256,address)\":{\"notice\":\"Commits the next nonce batch for the operator whose Schnorr key is `(x, y)`.\"},\"stakeRegistry()\":{\"notice\":\"The operator/PoP registry gating who may commit batches.\"}},\"notice\":\"On-chain commitment registry for **pre-committed MuSig2 nonce batches** \\u2014 the         piece that makes aggregate-Schnorr signing non-interactive (see         `docs/schnorr-nonce-registry.md`). Operators commit a Merkle root per batch of         nonce *points*; the full points travel p2p and peers verify them against these         roots. The chain never stores, opens, or verifies a nonce point.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/SchnorrNonceRegistry.sol\":\"SchnorrNonceRegistry\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@eigenlayer-middleware/=lib/eigenlayer-middleware/src/\",\":@openzeppelin-upgrades/=lib/eigenlayer-middleware/lib/openzeppelin-contracts-upgradeable/\",\":@openzeppelin/=lib/eigenlayer-middleware/lib/openzeppelin-contracts/\",\":ds-test/=lib/eigenlayer-middleware/lib/ds-test/src/\",\":eigenlayer-contracts/=lib/eigenlayer-middleware/lib/eigenlayer-contracts/\",\":eigenlayer-middleware/=lib/eigenlayer-middleware/\",\":erc4626-tests/=lib/eigenlayer-middleware/lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/eigenlayer-middleware/lib/forge-std/src/\",\":openzeppelin-contracts-upgradeable-v4.9.0/=lib/eigenlayer-middleware/lib/eigenlayer-contracts/lib/openzeppelin-contracts-upgradeable-v4.9.0/\",\":openzeppelin-contracts-upgradeable/=lib/eigenlayer-middleware/lib/openzeppelin-contracts-upgradeable/\",\":openzeppelin-contracts-v4.9.0/=lib/eigenlayer-middleware/lib/eigenlayer-contracts/lib/openzeppelin-contracts-v4.9.0/\",\":openzeppelin-contracts/=lib/eigenlayer-middleware/lib/openzeppelin-contracts/\",\":openzeppelin/=lib/eigenlayer-middleware/lib/openzeppelin-contracts/contracts/\",\":zeus-templates/=lib/eigenlayer-middleware/lib/eigenlayer-contracts/lib/zeus-templates/src/\"]},\"sources\":{\"src/SchnorrNonceRegistry.sol\":{\"keccak256\":\"0x74d91a67319536fbde1427d337742b16489431617234b00eb4a246b32af83d98\",\"license\":\"AGPL-3.0-only\",\"urls\":[\"bzz-raw://d9ba665b3cdd5bd5423d2926f3935dc7c98ac941d8bd7cb047a9c2f46a6c187b\",\"dweb:/ipfs/QmZe33GMbxHXjXRz4XvLVdaU9XMsb9WPjvc7zBrCwong5w\"]},\"src/interface/ISchnorrNonceRegistry.sol\":{\"keccak256\":\"0x6d938084c853db27c2f02693a68683603d8bad4ab165bbad1b13bc142ad4fc76\",\"license\":\"AGPL-3.0-only\",\"urls\":[\"bzz-raw://58a3df8231ef00b7718e8ca062daab6f86f931dcd53458bfb8a3b4512d658742\",\"dweb:/ipfs/QmPCoYq2qyT6bm8PmajsDaTnHEpz
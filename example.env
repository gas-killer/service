# =============================================================================
AVS_DEPLOYMENT_PATH="config/.nodes/avs_deploy.json"

# =============================================================================
# Private Keys
# =============================================================================
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FUNDED_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 # Required for TESTNET mode (should have testnet ETH)

# =============================================================================
# Operator Configuration
# =============================================================================
TEST_ACCOUNTS=3

# =============================================================================
# Contributor Key Files
# =============================================================================
# These will be generated by the Docker setup
# CONTRIBUTOR_1_KEYFILE="config/.nodes/operator_keys/testacc1.private.ecdsa.key.json"
# CONTRIBUTOR_2_KEYFILE="config/.nodes/operator_keys/testacc2.private.ecdsa.key.json"
